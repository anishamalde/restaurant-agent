# Copy to `.env` and fill in with your deployed resource values.
# `.env` is gitignored; this template is tracked.
# Source before running scripts:  set -a && source .env && set +a

# AWS
AWS_DEFAULT_REGION=eu-west-2

# Harness ARN from `npx @aws/agentcore deploy` (see README.md)
HARNESS_ARN=arn:aws:bedrock-agentcore:<AWS_REGION>:<AWS_ACCOUNT_ID>:harness/<HARNESS_NAME>

# Meta / WhatsApp Cloud API
META_TOKEN=<from Meta Business Suite → System Users>
META_PHONE_ID=<WhatsApp sender phone-number ID>
META_VERIFY_TOKEN=<any string; must match what you configure in Meta's webhook UI>
META_APP_SECRET=<Meta app dashboard → App settings → Basic → App secret; local_run.py signs test payloads with it>

# Owner (the only actor authorised to write)
OWNER_WHATSAPP_NUMBER=+<your E.164 number>

# S3 bucket for the JSON state files
DATA_BUCKET=<globally-unique bucket name>

# Google Places + Distance Matrix
GOOGLE_MAPS_API_KEY=<from Google Cloud Console → APIs & Services → Credentials>

# Optional: simulated sender for scripts/chat.py --as and scripts/local_run.py --sender
CHAT_SENDER=<your number without the leading +>
